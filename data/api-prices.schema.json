{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pay-per-token API price entries (per 1M tokens)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "vendor",
      "model",
      "region",
      "currency",
      "input",
      "output",
      "buyUrl",
      "sourceUrl",
      "verifiedAt",
      "confidence"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "vendor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "model": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "region": {
        "enum": [
          "global"
        ]
      },
      "currency": {
        "enum": [
          "USD"
        ]
      },
      "input": {
        "type": "number",
        "minimum": 0
      },
      "output": {
        "type": "number",
        "minimum": 0
      },
      "cacheHit": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      },
      "cacheWrite": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      },
      "context": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 40
      },
      "tiering": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 200,
        "description": "Official rules such as tiered pricing, long-context surcharges and off-peak discounts"
      },
      "multimodal": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "buyUrl": {
        "type": "string",
        "pattern": "^https://"
      },
      "sourceUrl": {
        "type": "string",
        "pattern": "^https://"
      },
      "verifiedAt": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "confidence": {
        "enum": [
          "high",
          "medium",
          "low"
        ]
      },
      "notes": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 240
      },
      "platformId": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "description": "Same as plans.platformId"
      },
      "priceVerifiedAt": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    }
  }
}
