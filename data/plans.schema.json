{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Coding plan / subscription pricing entries",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "vendor",
      "name",
      "region",
      "kind",
      "price",
      "quota",
      "buyUrl",
      "sourceUrl",
      "verifiedAt",
      "status",
      "confidence"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "description": "Globally unique slug; never renamed across versions"
      },
      "vendor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "region": {
        "enum": [
          "global"
        ]
      },
      "kind": {
        "enum": [
          "coding-plan",
          "token-plan",
          "ide",
          "free"
        ],
        "description": "coding-plan = vendor quota bundle; token-plan = quota/credit pack; ide = editor or agent tool subscription; free = free tier"
      },
      "price": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "amount",
          "currency",
          "period"
        ],
        "properties": {
          "amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "currency": {
            "enum": [
              "USD"
            ]
          },
          "period": {
            "enum": [
              "month",
              "quarter",
              "year",
              "week",
              "none"
            ]
          },
          "firstPeriodAmount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          }
        }
      },
      "models": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 60
        },
        "description": "Main models available on this tier, using official model ids"
      },
      "quota": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300,
        "description": "Compact paraphrase of the official quota text; write 'Not published by the provider' when there is none"
      },
      "quotaWindow": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "fiveHours": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "maxLength": 160,
            "description": "Official quota value or wording; see quotaUnit for the unit"
          },
          "week": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "maxLength": 160,
            "description": "Official quota value or wording; see quotaUnit for the unit"
          },
          "month": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "maxLength": 160,
            "description": "Official quota value or wording; see quotaUnit for the unit"
          }
        }
      },
      "tokenAllowance": {
        "type": [
          "object",
          "null"
        ],
        "description": "Fill only when the provider states a token count, to estimate quota value; otherwise null, never infer",
        "additionalProperties": false,
        "properties": {
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "enum": [
              "million-tokens",
              "credits"
            ]
          },
          "period": {
            "enum": [
              "month",
              "week",
              "five-hours"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "multimodal": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "buyUrl": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^https://",
        "description": "Direct purchase link; may be null only when confidence=low or status=unknown (enforced by validate.mjs)"
      },
      "sourceUrl": {
        "type": "string",
        "pattern": "^https://"
      },
      "verifiedAt": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "status": {
        "enum": [
          "active",
          "sold-out-daily",
          "discontinued",
          "coming-soon",
          "unknown",
          "no-plan"
        ]
      },
      "confidence": {
        "enum": [
          "high",
          "medium",
          "low"
        ],
        "description": "high = confirmed on the official page; medium = official page but inferred or paraphrased; low = unverified"
      },
      "notes": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 240
      },
      "includedCredit": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "description": "Usage credit in currency bundled with the plan (e.g. $60/month); fill only when stated officially",
        "properties": {
          "amount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "currency": {
            "enum": [
              "USD"
            ]
          },
          "period": {
            "enum": [
              "month",
              "week",
              "day"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "text"
        ]
      },
      "quotaUnit": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "requests",
          "credits",
          "tokens",
          "multiplier",
          null
        ],
        "description": "Unit of quotaWindow: requests, credits (vendor points), tokens, or multiplier (e.g. 5x Pro)"
      },
      "platformId": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "description": "Platform id from platforms.json; marks the seller as first-party, cloud platform or reseller"
      },
      "priceVerifiedAt": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "channel": {
        "type": "string",
        "enum": [
          "Web",
          "Apple App Store"
        ]
      },
      "audience": {
        "type": "string",
        "enum": [
          "individual",
          "team",
          "enterprise"
        ]
      },
      "codingAccess": {
        "type": "boolean"
      },
      "fees": {
        "type": "string",
        "maxLength": 240
      },
      "availability": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "US": {
            "enum": [
              "confirmed",
              "unconfirmed",
              "unavailable"
            ]
          },
          "PK": {
            "enum": [
              "confirmed",
              "unconfirmed",
              "unavailable"
            ]
          },
          "AE": {
            "enum": [
              "confirmed",
              "unconfirmed",
              "unavailable"
            ]
          },
          "SA": {
            "enum": [
              "confirmed",
              "unconfirmed",
              "unavailable"
            ]
          }
        }
      }
    }
  }
}
